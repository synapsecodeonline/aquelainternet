{
  "name": "Aquela Internet — Post diário no Instagram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 12 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Diário 12h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "https://aquelainternet.vercel.app/api/cron/daily?dry=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.CRON_SECRET}}"
            }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "get-card",
      "name": "Pega card do dia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v21.0/{{$env.IG_USER_ID}}/media",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"image_url\": \"{{ $json.cardUrl }}\",\n  \"caption\": \"{{ $json.caption }}\",\n  \"access_token\": \"{{ $env.IG_ACCESS_TOKEN }}\"\n}",
        "options": { "timeout": 60000 }
      },
      "id": "ig-container",
      "name": "Cria mídia no IG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "url": "https://graph.facebook.com/v21.0/{{$env.IG_USER_ID}}/media_publish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"creation_id\": \"{{ $('Cria mídia no IG').item.json.id }}\",\n  \"access_token\": \"{{ $env.IG_ACCESS_TOKEN }}\"\n}",
        "options": { "timeout": 60000 }
      },
      "id": "ig-publish",
      "name": "Publica no IG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Diário 12h": {
      "main": [[{ "node": "Pega card do dia", "type": "main", "index": 0 }]]
    },
    "Pega card do dia": {
      "main": [[{ "node": "Cria mídia no IG", "type": "main", "index": 0 }]]
    },
    "Cria mídia no IG": {
      "main": [[{ "node": "Publica no IG", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "pinData": {}
}
